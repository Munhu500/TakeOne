{
  "name": "takeone",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:verify": "bash scripts/db-verify.sh",
    "seed": "pnpm --filter @takeone/seed seed",
    "samples": "pnpm --filter @takeone/video-worker samples",
    "build:preview": "bash scripts/build-preview.sh",
    "serve:preview": "node scripts/preview-server.cjs preview-dist 8090"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  }
}