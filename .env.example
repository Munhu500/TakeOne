# Copy to .env at the repo root. Shared by apps/web, services/video-worker and scripts.
# DEMO_MODE=true (or any missing key below) uses the mock provider for that service.
DEMO_MODE=true

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Needed only with DEMO_MODE=false (Stripe webhooks, YouTube API verification). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# Video worker: either the service role key above, or a least-privilege worker login (see README "Worker login")
WORKER_EMAIL=worker@takeone.internal
WORKER_PASSWORD=

# AI providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=            # Whisper speech-to-text
ELEVENLABS_API_KEY=        # voice clone + dubbing
REPLICATE_API_TOKEN=       # video matting for scene replacement

# Payments
STRIPE_SECRET_KEY=         # sk_test_...
STRIPE_WEBHOOK_SECRET=     # whsec_...
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# YouTube Data API verification (OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
