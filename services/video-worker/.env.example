# The worker reads the repo-root .env too. In a container, pass these as environment variables.
DEMO_MODE=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
WORKER_EMAIL=worker@takeone.internal
WORKER_PASSWORD=
# or: SUPABASE_SERVICE_ROLE_KEY=
POLL_INTERVAL_MS=3000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
